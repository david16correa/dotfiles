// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        "title",
        "separator",
        {
            "type": "os",
            "key": "",
            "keyColor": "yellow",
            "format": "{2} {3}"
        },
        {
            "type": "command",
            "key": "󰔟",
            "keyColor": "yellow",
            "text": "echo $(( ($(date +%s) - $(stat -c %W /)) / 86400 )) days"
        },
        {
            "type": "kernel",
            "key": "",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "󰏖",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "",
            "keyColor": "yellow"
        },
        {
            "type": "datetime",
            "format": "{1}.{3}.{11}",
            "key": "",
            "keyColor": "yellow",
        },
        {
            "type": "uptime",
            "key": "󰅐",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "de",
            "key": "",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "󱪳",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "",
            "format": "{5}",
            "keyColor": "blue"
        },
        {
            "type": "media",
            "key": "󰝚",
            "format":"{3} - {2}",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "host",
            "key": "󰌢",
            "format": "{version}",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "󰻠",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰍛",
            "keyColor": "green"
        },
        {
            "type": "btrfs",
            // "folders": ["/"],
            "key": "󰉋",
            "keyColor": "green",
            "format": "root: {used-percentage} used ({allocated-percentage} allocated)",
        },
        // {
        //     "type": "disk",
        //     "folders": ["/home"],
        //     "key": "󱂵",
        //     "keyColor": "green",
        //     "format": "home: {3} full",
        // },
        "break",
        "colors",
    ]
}
