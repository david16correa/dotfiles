#! /usr/bin/env bash

# This is an idempotent script that will setup all my flatpak packages for me.
# All I need to do, is declare my apps here:

desiredApps=(
  com.discordapp.Discord
  us.zoom.Zoom
)

########################################
# preamble
########################################

# I like having nice colors
targetColor="\033[36m"
infoColor="\033[32m"
errorColor="\033[31m"
warningColor="\033[33m"
resetSeq="\033[0m"

# I save my installed apps in an array
mapfile -t installedApps < <(flatpak list --app --columns=application)

# An auxiliary function
isDesired(){
  local candidateApp="$1"
  # we compare the candidate with every desired app
  for desiredApp in "${desiredApps[@]}"; do
    # if there's a match, we return 0 (success)
    [[ "$candidateApp" == "$desiredApp" ]] && return 0
  done
  # else we return 1 (failure)
  return 1
}

########################################
# main
########################################

# 0. Sanity checks
# Make sure flatpak is installed
if ! command -v flatpak >/dev/null 2>&1; then
  echo -e "${errorColor}Error:${resetSeq} flatpak is not installed!" >&2
  echo -e "${warningColor}Solution:${resetSeq} add"
  echo "services.flatpak.enable = true;"
  echo "to your configs"
  exit 1
fi

# Add the flathub repository
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

# 1. Cleanup
# Remove any flatpaks I no longer need
for installedApp in "${installedApps[@]}"; do
  isDesired "$installedApp" || flatpak uninstall -y --noninteractive $installedApp
done
# Remove any unused stuff
flatpak remove --unused --noninteractive

# 2. Install: Add all my apps
flatpak install -y "${desiredApps[@]}"

# 3. Extra
# Expose and apply my cursor theme
flatpak override --user --filesystem=~/.local/share/icons:ro
flatpak override --user --filesystem=/nix/store:ro
flatpak override --user --env=XCURSOR_THEME=Adwaita
flatpak override --user --env=XCURSOR_SIZE=24

# A quick reminder
echo -e "${warningColor}To complete the initial setup, restart your system!${resetSeq}"

# If desired, we update
while [[ $# -gt 0 ]]; do
  case "$1" in
    --update) flatpak update ;;
    *) echo "Unknown option: $1; Ignoring..." >&2 ;;
  esac
  shift
done

# 4. done!
exit 0
