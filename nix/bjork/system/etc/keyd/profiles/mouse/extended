#------------------------------------------------------------------------------#
# these settings are applied to all Logitech mice

[ids]
m:046d

#------------------------------------------------------------------------------#
[main]

# Logitech MX Master 3S Mouse
mouse1 = overload(alpha,mouse1)
mouse2 = overload(beta,mouse2)
mouseforward = lettermod(gamma, toggle(epsilon), 150, 200)

# Logitech G502 HERO Gaming Mouse
1 = overload(alpha,mouse1)
2 = overload(beta,mouse2)
3 = lettermod(gamma, toggle(epsilon), 150, 200)

4 = volumedown
5 = volumeup
6 = noop
7 = noop

[epsilon]

mouseforward = lettermod(delta, toggle(epsilon), 150, 200)
3 = lettermod(delta, toggle(epsilon), 150, 200)

#------------------------------------------------------------------------------#
# productivity layer; copy, paste, undo, scroll to zoom
[alpha:A]
leftmouse = C-insert
middlemouse = C-z
rightmouse = S-insert

4 = S-delete
5 = C-insert

#------------------------------------------------------------------------------#
# media and workspaces layer; playpause, next song, scroll through workspaces
[beta:M]
leftmouse = playpause
middlemouse = M-a
rightmouse = nextsong

4 = previoussong
5 = nextsong

#------------------------------------------------------------------------------#
# misc layer; cut, previous song, redo
[alpha+beta]
leftmouse = S-delete
middlemouse = C-S-z
rightmouse = previoussong

4 = esc
5 = enter

#------------------------------------------------------------------------------#
# audio layer; volume up/down, mute, sideways scroll
[gamma:C]
leftmouse = volumedown
middlemouse = mute
rightmouse = volumeup

4 = brightnessdown
5 = brightnessup

#------------------------------------------------------------------------------#
# alternate audio layer; volume up/down, mute, scroll to zoom in/out
[delta:S]
leftmouse = volumedown
middlemouse = mute
rightmouse = volumeup

4 = brightnessdown
5 = brightnessup
