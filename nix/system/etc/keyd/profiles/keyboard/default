# tip: use `keyd list-keys` to list keys
# tip: use `sudo keyd monitor` to monitor key strokes

#------------------------------------------------------------------------------#
# these settings are applied across all keyboards; not my Logitech mice
[ids]
*
-m:046d

#------------------------------------------------------------------------------#
[main]

# Left Alt is swapped with Left Meta
leftmeta = layer(alt)
leftalt = layer(meta)

# Left Control and Copilot acts as Hyper
leftcontrol = layer(hyper)
leftmeta+leftshift+f23 = layer(hyper)

# Space acts as Space when tapped, and as Alpha when held
space = lettermod(alpha, space, 150, 200)

# Esc acts as Esc when tapped, and as Beta when held
esc = overload(beta, esc)

# Caps Lock acts as Esc when tapped, and as Gamma when held
capslock = overload(gamma,esc)

#------------------------------------------------------------------------------#
# layers are included
include profiles/keyboard/layers
