#------------------------------------------------------------------------------#
# these settings are applied to all Logitech mice

[ids]
m:046d

#------------------------------------------------------------------------------#
[main]

# Logitech MX Master 3S Mouse
mouse1 = overload(control,C-S-z)
mouse2 = overload(meta,C-z)
mouseforward = overload(shift,enter)

# Logitech G502 HERO Gaming Mouse
1 = overload(control,C-z)
2 = overload(meta,C-S-z)
3 = overload(shift,enter)

4 = volumedown
5 = volumeup
6 = noop
7 = noop

#------------------------------------------------------------------------------#
[control]

4 = S-delete
5 = C-insert

#------------------------------------------------------------------------------#
[meta]

4 = previoussong
5 = nextsong

#------------------------------------------------------------------------------#
# media layer
[control+meta]
leftmouse = playpause
rightmouse = nextsong

4 = esc
5 = enter
6 = previoussong
7 = nextsong

#------------------------------------------------------------------------------#
[shift]

4 = brightnessdown
5 = brightnessup
