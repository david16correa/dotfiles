spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
spawn-sh-at-startup "vicinae server"

input {
    keyboard {
        xkb {
          layout "us(symbolic),latam"
          options "compose:rwin"
        }
        repeat-delay 300
        repeat-rate 100
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.5
    }

    mouse {
        natural-scroll
    }

    trackpoint {
        accel-speed 0.0
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    // warp-mouse-to-focus
    // focus-follows-mouse
    // focus-follows-mouse max-scroll-amount="49%"
    focus-follows-mouse max-scroll-amount="0%"
}

// use `niri msg outputs` to see montiros currently in use
// ThinkPad
output "eDP-1"{
  mode "1920x1200@60.026"
  variable-refresh-rate
  scale 1
  position x=0 y=0
}
// MG300
output "DP-2"{
  mode "1920x1080@74.986"
  scale 1
  position x=1920 y=0
}
// Samsung@Tec
output "Samsung Electric Company S22F350 H4ZHC02955"{
  mode "1920x1080@60.000"
  scale 1
  position x=0 y=-1080
}

layout {
    gaps 8

    center-focused-column "never"
    always-center-single-column
    empty-workspace-above-first

    preset-column-widths {
        // proportion 0.75
        proportion 0.66667
        proportion 0.5
        proportion 0.33333
        // proportion 0.25
        // fixed 1920
    }

    default-column-width { proportion 0.66667; }

    focus-ring {
        width 4
        active-color "#7aa2f7"
        inactive-color "#c0caf5"
    }

    struts {
        // left 64
        // right 64
        top -4
        bottom -4
    }
}

environment {
    DISPLAY ":0"
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// overall rules for windows
prefer-no-csd
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// exceptions to tiling
window-rule {
    match app-id=r#"firefox$"#                      title="^Picture-in-Picture$"
    match app-id=r#"zen-browser$"#                  title="^Picture-in-Picture$"
    match app-id="org.gnome.NautilusPreviewer"
    match app-id="org.gnome.Loupe"                  title="display.png"
    match app-id="steam"                            title="Recordings.*Screenshots"
    match app-id="__main__.py"                      title="LaTeX.*TexText"
    match app-id="zoom"                             title="meeting.*popup"
    match app-id="org.inkscape.Inkscape"            title="import"

    open-floating true
}

// Allows notification actions and window activation from Noctalia.
debug {
  honor-xdg-activation-with-invalid-serial
}

// Set the overview wallpaper on the backdrop.
layer-rule {
  match namespace="^noctalia-overview*"
  place-within-backdrop true
}

binds {
  // help
  Mod+Shift+Slash { show-hotkey-overlay; }

  // general launchers
  Mod+Return                 hotkey-overlay-title="Open a Terminal"              { spawn "kitty"; }
  // Mod+Space                  hotkey-overlay-title="Run an Application"           { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
  Mod+Space                  hotkey-overlay-title="Run an Application"           { spawn-sh "vicinae toggle"; }
  Mod+S                      hotkey-overlay-title="Control Center"               { spawn-sh "qs -c noctalia-shell ipc call controlCenter toggle"; }
  Mod+Shift+Return           hotkey-overlay-title="Settings"                     { spawn-sh "qs -c noctalia-shell ipc call settings toggle"; }
  Mod+M                      hotkey-overlay-title="Calendar"                     { spawn-sh "qs -c noctalia-shell ipc call calendar toggle"; }
  Mod+N                      hotkey-overlay-title="Notification History"         { spawn-sh "qs -c noctalia-shell ipc call notifications toggleHistory"; }
  Mod+Ctrl+N                 hotkey-overlay-title="Do Not Disturb"               { spawn-sh "qs -c noctalia-shell ipc call notifications toggleDND"; }
  Mod+V                      hotkey-overlay-title="Clipboard History"            { spawn-sh "qs -c noctalia-shell ipc call launcher clipboard"; }

  // session actions
  Mod+C                      hotkey-overlay-title="Caffeinate"                   { spawn-sh "qs -c noctalia-shell ipc call idleInhibitor toggle"; }
  Mod+Shift+Alt+Ctrl+Return  hotkey-overlay-title="Session Menu"                 { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
  Mod+Shift+Alt+Ctrl+L       hotkey-overlay-title="Lock the Screen"              { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }
  Mod+Shift+Alt+Ctrl+Q       hotkey-overlay-title="Lock and Suspend"             { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock && systemctl suspend"; }
  Mod+Shift+Alt+Ctrl+P       hotkey-overlay-title="Power off all montiors"       { power-off-monitors; }
  Ctrl+Alt+Delete            hotkey-overlay-title="Quit Niri"                    { quit; }

  // favourite apps
  Mod+1                      hotkey-overlay-title="Open (or focus) Files"        { spawn-sh "/home/david/.myScripts/focusOrLaunch org.gnome.Nautilus nautilus"; }
  Mod+2                      hotkey-overlay-title="Open (or focus) a Terminal"   { spawn-sh "/home/david/.myScripts/focusOrLaunch kitty kitty"; }
  Mod+3                      hotkey-overlay-title="Open (or focus) Zen Browser"  { spawn-sh "/home/david/.myScripts/focusOrLaunch zen zen-browser"; }
  Mod+4                      hotkey-overlay-title="Open (or focus) Spotify"      { spawn-sh "/home/david/.myScripts/focusOrLaunch Spotify spotify-launcher"; }
  Mod+5                      hotkey-overlay-title="Open (or focus) Zotero"       { spawn-sh "/home/david/.myScripts/focusOrLaunch Zotero zotero"; }
  Mod+6                      hotkey-overlay-title="Open (or focus) Obsidian"     { spawn-sh "/home/david/.myScripts/focusOrLaunch obsidian obsidian"; }
  Mod+7                      hotkey-overlay-title="Toggle Settings"              { spawn-sh "qs -c noctalia-shell ipc call settings toggle"; }

  // screenshots
  Print        { screenshot; }
  Shift+Print   { screenshot-screen; }
  Alt+Print    { screenshot-window; }

  // change keyboard layout
  Mod+F1       { switch-layout "next"; }

  // volume keys mappings for PipeWire & WirePlumber.
  XF86AudioRaiseVolume       allow-when-locked=true      { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ --limit=1"; }
  XF86AudioLowerVolume       allow-when-locked=true      { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
  XF86AudioMute              allow-when-locked=true      { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
  XF86AudioMicMute           allow-when-locked=true      { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
  XF86AudioPlay              allow-when-locked=true      { spawn-sh "playerctl play-pause"; }
  XF86AudioPrev              allow-when-locked=true      { spawn-sh "playerctl previous"; }
  XF86AudioNext              allow-when-locked=true      { spawn-sh "playerctl next"; }

  // brightness key mappings for brightnessctl.
  XF86MonBrightnessUp        allow-when-locked=true      { spawn-sh "brightnessctl --class=backlight set +10%"; }
  XF86MonBrightnessDown      allow-when-locked=true      { spawn-sh "brightnessctl --class=backlight set 10%-"; }

  // closing windows and overview
  Mod+A repeat=false   { toggle-overview; }
  Mod+Q repeat=false   { close-window; }

  // focus (Mod+Direction) and move (Mod+Ctrl+Direction) windows accross workspaces
  Mod+Left             { focus-column-left; }
  Mod+Down             { focus-window-or-workspace-down; }
  Mod+Up               { focus-window-or-workspace-up; }
  Mod+Right            { focus-column-right; }
  Mod+H                { focus-column-left; }
  Mod+J                { focus-window-or-workspace-down; }
  Mod+K                { focus-window-or-workspace-up; }
  Mod+L                { focus-column-right; }
  Mod+Ctrl+Left        { move-column-left; }
  Mod+Ctrl+Down        { move-window-down; }
  Mod+Ctrl+Up          { move-window-up; }
  Mod+Ctrl+Right       { move-column-right; }
  Mod+Ctrl+H           { move-column-left; }
  Mod+Ctrl+J           { move-window-down-or-to-workspace-down; }
  Mod+Ctrl+K           { move-window-up-or-to-workspace-up; }
  Mod+Ctrl+L           { move-column-right; }
  Mod+Home             { focus-column-first; }
  Mod+End              { focus-column-last; }
  Mod+Ctrl+Home        { move-column-to-first; }
  Mod+Ctrl+End         { move-column-to-last; }
  Mod+Tab              { focus-workspace-previous; }

  // focus (Mod+Shift+Direction) and move (Mod+Shift+Ctrl+Direction) windows accross monitors
  Mod+Shift+Left       { focus-monitor-left; }
  Mod+Shift+Down       { focus-monitor-down; }
  Mod+Shift+Up         { focus-monitor-up; }
  Mod+Shift+Right      { focus-monitor-right; }
  Mod+Shift+H          { focus-monitor-left; }
  Mod+Shift+J          { focus-monitor-down; }
  Mod+Shift+K          { focus-monitor-up; }
  Mod+Shift+L          { focus-monitor-right; }
  Mod+Shift+Tab          { focus-monitor-next; }
  Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
  Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
  Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
  Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

  // stacking windows in a column
  Mod+BracketLeft      { consume-or-expel-window-left; }
  Mod+BracketRight     { consume-or-expel-window-right; }
  Mod+Comma            { consume-window-into-column; }
  Mod+Period           { expel-window-from-column; }

  // managing window sizes
  Mod+R                { switch-preset-column-width; }
  Mod+Shift+R          { switch-preset-window-height; }
  Mod+Ctrl+R           { reset-window-height; }
  Mod+F                { maximize-column; }
  Mod+Ctrl+F           { fullscreen-window; }
  Mod+Shift+F          { expand-column-to-available-width; }
  Mod+Minus            { set-column-width "-10%"; }
  Mod+Equal            { set-column-width "+10%"; }
  Mod+Ctrl+Minus       { set-window-height "-10%"; }
  Mod+Ctrl+Equal       { set-window-height "+10%"; }

  // misc - centering windows, floating windows, and tabbed column display
  Mod+I                { center-column; }
  Alt+I                { center-window; }
  Mod+T                { toggle-window-floating; }
  Mod+Ctrl+T           { switch-focus-between-floating-and-tiling; }
  Mod+W                { toggle-column-tabbed-display; }

  // move workspaces within a monitor
  Mod+Ctrl+Page_Down   { move-workspace-down; }
  Mod+Ctrl+Page_Up     { move-workspace-up; }
  Mod+Ctrl+U           { move-workspace-down; }
  Mod+Ctrl+I           { move-workspace-up; }

  // move workspaces across monitors
  Mod+Alt+H            { move-workspace-to-monitor-left; }
  Mod+Alt+J            { move-workspace-to-monitor-down; }
  Mod+Alt+K            { move-workspace-to-monitor-up; }
  Mod+Alt+L            { move-workspace-to-monitor-right; }

  // scroll wheel stuff - focus
  Mod+WheelScrollDown  { focus-column-right; }
  Mod+WheelScrollUp    { focus-column-left; }
  Alt+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
  Alt+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }

  // Applications such as remote-desktop clients and software KVM switches may
  // request that niri stops processing the keyboard shortcuts defined here
  // so they may, for example, forward the key presses as-is to a remote machine.
  // It's a good idea to bind an escape hatch to toggle the inhibitor,
  // so a buggy application can't hold your session hostage.
  //
  // The allow-inhibiting=false property can be applied to other binds as well,
  // which ensures niri always processes them, even when an inhibitor is active.
  Mod+Delete allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
