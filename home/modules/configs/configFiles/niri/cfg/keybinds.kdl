// hyper = Super+Shift+Alt+Ctrl
binds {
  ////////////////////////////////////////
  // launchers
  ////////////////////////////////////////
  Mod+Return                  hotkey-overlay-title="Open a Terminal"                repeat=false   { spawn-sh "kitty"; }
  Mod+Shift+Return            hotkey-overlay-title="Open a Terminal (floating)"     repeat=false   { spawn-sh "kitty --class=dot.floating.large.kitty"; }
  Alt+Return                  hotkey-overlay-title="Open Yazi"                      repeat=false   { spawn-sh "kitty yazi"; }
  Alt+Shift+Return            hotkey-overlay-title="Open Yazi (floating)"           repeat=false   { spawn-sh "kitty --class=dot.floating.kitty yazi"; }
  Mod+Print                   hotkey-overlay-title="Open Color Picker"              repeat=false   { spawn-sh "gcolor3"; }
  Mod+B                       hotkey-overlay-title="Open bluetui (floating)"        repeat=false   { spawn-sh "kitty --class=dot.floating.kitty bluetui"; }
  Super+Shift+Alt+Ctrl+K      hotkey-overlay-title="Open keydprofile (floating)"    repeat=false   { spawn-sh "kitty --class=dot.floating.kitty keydprofile --gui"; }
  Super+Shift+Alt+Ctrl+J      hotkey-overlay-title="Open Julia (floating)"          repeat=false   { spawn-sh "kitty --class=dot.floating.kitty julia"; }
  Mod+Y                       hotkey-overlay-title="Open btop (floating)"           repeat=false   { spawn-sh "kitty --class=dot.floating.large.kitty btop"; }

  ////////////////////////////////////////
  // favourite apps
  ////////////////////////////////////////
  Mod+1                       hotkey-overlay-title="Open (or focus) Files"          repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch org.gnome.Nautilus nautilus"; }
  Mod+2                       hotkey-overlay-title="Open (or focus) a Terminal"     repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch kitty kitty"; }
  Mod+3                       hotkey-overlay-title="Open (or focus) Zen Browser"    repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch zen-beta zen-beta"; }
  Mod+4                       hotkey-overlay-title="Open (or focus) Spotify"        repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch spotify spotify"; }
  Mod+5                       hotkey-overlay-title="Open (or focus) Zotero"         repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch Zotero zotero"; }
  Mod+6                       hotkey-overlay-title="Open (or focus) Obsidian"       repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch obsidian obsidian"; }
  Mod+7                       hotkey-overlay-title="Open (or focus) WhatsApp"       repeat=false   { spawn-sh "$XDG_BIN_HOME/focusOrLaunch com.rtosta.zapzap zapzap"; }
  Mod+0                       hotkey-overlay-title="Toggle Settings"                repeat=false   { spawn-sh "noctalia msg settings-open"; }

  ////////////////////////////////////////
  // shell
  ////////////////////////////////////////
  Mod+Space                   hotkey-overlay-title="Run an Application"             repeat=false   { spawn-sh "noctalia msg panel-toggle launcher"; }
  Super+Shift+Alt+Ctrl+Space  hotkey-overlay-title="Emoji picker"                   repeat=false   { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
  // Alt+Space                hotkey-overlay-title="Run an Application: vicinae"    repeat=false   { spawn-sh "vicinae toggle"; }
  Mod+V                       hotkey-overlay-title="Clipboard History"              repeat=false   { spawn-sh "noctalia msg panel-toggle clipboard"; }
  Mod+S                       hotkey-overlay-title="Control Center"                 repeat=false   { spawn-sh "noctalia msg panel-toggle control-center"; }
  Super+Shift+Alt+Ctrl+M      hotkey-overlay-title="Media Panel"                    repeat=false   { spawn-sh "noctalia msg panel-toggle control-center media"; }
  Super+Shift+Alt+Ctrl+A      hotkey-overlay-title="Audio Panel"                    repeat=false   { spawn-sh "noctalia msg panel-toggle control-center audio"; }
  Super+Shift+Alt+Ctrl+D      hotkey-overlay-title="Montitor (Displays) Panel"      repeat=false   { spawn-sh "noctalia msg panel-toggle control-center monitor"; }
  Super+Shift+Alt+Ctrl+S      hotkey-overlay-title="System Panel"                   repeat=false   { spawn-sh "noctalia msg panel-toggle control-center system"; }
  Super+Shift+Alt+Ctrl+N      hotkey-overlay-title="Wifi/Network Panel"             repeat=false   { spawn-sh "noctalia msg panel-toggle control-center network"; }
  Super+Shift+Alt+Ctrl+B      hotkey-overlay-title="Bluetooth Panel"                repeat=false   { spawn-sh "noctalia msg panel-toggle control-center bluetooth"; }
  Super+Shift+Alt+Ctrl+W      hotkey-overlay-title="Weather Panel"                  repeat=false   { spawn-sh "noctalia msg panel-toggle control-center weather"; }
  Super+Shift+Alt+Ctrl+C      hotkey-overlay-title="Calendar"                       repeat=false   { spawn-sh "noctalia msg panel-toggle control-center calendar"; }
  Mod+M                                                                             repeat=false   { spawn-sh "noctalia msg panel-toggle control-center calendar"; }
  Mod+N                       hotkey-overlay-title="Notification History"           repeat=false   { spawn-sh "noctalia msg panel-toggle control-center notifications"; }

  ////////////////////////////////////////
  // toggles of state
  ////////////////////////////////////////
  Mod+Ctrl+N                  hotkey-overlay-title="Do Not Disturb"                 repeat=false   { spawn-sh "noctalia msg notification-dnd-toggle"; }
  Mod+C                       hotkey-overlay-title="Caffeinate"                     repeat=false   { spawn-sh "noctalia msg caffeine-toggle"; }
  Super+Shift+Alt+Ctrl+Delete hotkey-overlay-title="Toggle the internal monitor"    repeat=false   { spawn-sh "$XDG_BIN_HOME/toggle-eDP-1"; }

  ////////////////////////////////////////
  // session binds
  ////////////////////////////////////////
  Mod+Escape                  hotkey-overlay-title="Session Menu"                   repeat=false   { spawn-sh "noctalia msg panel-toggle session"; }
  Super+Shift+Alt+Ctrl+Q      hotkey-overlay-title="Lock the Screen"                repeat=false   { spawn-sh "noctalia msg session lock"; }
  Super+Shift+Alt+Ctrl+P      hotkey-overlay-title="Power off all montiors"         repeat=false   { power-off-monitors; }

  ////////////////////////////////////////
  // misc
  ////////////////////////////////////////
  Ctrl+Shift+Slash                                                                  repeat=false   { show-hotkey-overlay; }
  Mod+F1                                                                            repeat=false   { switch-layout "next"; }
  Ctrl+Alt+Delete             hotkey-overlay-title="Quit Niri"                      repeat=false   { quit; }

  ////////////////////////////////////////
  // media keys
  ////////////////////////////////////////
  // audio
  XF86AudioRaiseVolume        hotkey-overlay-title="Raise Volume"                   allow-when-locked=true             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ --limit=1"; }
  XF86AudioLowerVolume        hotkey-overlay-title="Lower Volume"                   allow-when-locked=true             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
  Ctrl+XF86AudioRaiseVolume   hotkey-overlay-title="Raise Volume (1%)"              allow-when-locked=true             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ --limit=1"; }
  Ctrl+XF86AudioLowerVolume   hotkey-overlay-title="Lower Volume (1%)"              allow-when-locked=true             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01-"; }
  Mod+Alt+WheelScrollDown                                                           allow-when-locked=true             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01+ --limit=1"; }
  Mod+Alt+WheelScrollUp                                                             allow-when-locked=true             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.01-"; }

  XF86AudioMute               hotkey-overlay-title="Mute Audio"              allow-when-locked=true repeat=false       { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
  Ctrl+MouseMiddle                                                           allow-when-locked=true repeat=false       { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
  XF86AudioMicMute            hotkey-overlay-title="Mute Mic"                allow-when-locked=true repeat=false       { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

  XF86AudioPlay               hotkey-overlay-title="Play-pause"              allow-when-locked=true repeat=false       { spawn-sh "playerctl play-pause"; }
  Ctrl+XF86AudioPlay          hotkey-overlay-title="Play-pause (all)"        allow-when-locked=true repeat=false       { spawn-sh "playerctl play-pause -a"; }

  XF86AudioPrev               hotkey-overlay-title="Previous song"           allow-when-locked=true repeat=false       { spawn-sh "playerctl previous"; }
  XF86AudioNext               hotkey-overlay-title="Next song"               allow-when-locked=true repeat=false       { spawn-sh "playerctl next"; }

  // brightness
  XF86MonBrightnessUp                                                               allow-when-locked=true             { spawn-sh "noctalia msg brightness-up 10"; }
  XF86MonBrightnessDown                                                             allow-when-locked=true             { spawn-sh "noctalia msg brightness-down 10"; }
  Shift+XF86MonBrightnessUp                                                  allow-when-locked=true repeat=false       { spawn-sh "noctalia msg brightness-set 100"; }
  Shift+XF86MonBrightnessDown                                                allow-when-locked=true repeat=false       { spawn-sh "noctalia msg brightness-set 0"; }

  Alt+XF86MonBrightnessUp                                                           allow-when-locked=true             { spawn-sh "brightnessctl --device='tpacpi::kbd_backlight' set 1+"; }
  Alt+XF86MonBrightnessDown                                                         allow-when-locked=true             { spawn-sh "brightnessctl --device='tpacpi::kbd_backlight' set 1-"; }
  Shift+Alt+XF86MonBrightnessUp                                              allow-when-locked=true repeat=false       { spawn-sh "brightnessctl --device='tpacpi::kbd_backlight' set 2"; }
  Shift+Alt+XF86MonBrightnessDown                                            allow-when-locked=true repeat=false       { spawn-sh "brightnessctl --device='tpacpi::kbd_backlight' set 0"; }

  // select and set up display devices
  XF86Display                                                                       repeat=false   { spawn-sh "kitty nvim $HOME/.config/niri/cfg/output.kdl"; }

  // screenshots
  Print                                                                             repeat=false   { screenshot-screen; }
  Shift+Print                                                                       repeat=false   { screenshot; }
  XF86Launch7                                                                       repeat=false   { screenshot; } // keyd turns XF86SelectiveScreenshot into XF86Launch7
  XF86SelectiveScreenshot                                                           repeat=false   { screenshot; }
  Alt+Print                                                                         repeat=false   { screenshot-window; }

  // phone link
  f23                                                                               repeat=false   { spawn "localsend_app"; } // keyd turns XF86LinkPhone into f23
  XF86LinkPhone                                                                     repeat=false   { spawn "localsend_app"; }

  ////////////////////////////////////////
  // window management
  ////////////////////////////////////////
  // closing windows and overview
  Mod+A                                                                             repeat=false   { toggle-overview; }
  Mod+Q                                                                             repeat=false   { close-window; }
  Mod+MouseMiddle                                                                   repeat=false   { close-window; }

  // focus (Mod+Direction) and move (Mod+Ctrl+Direction) windows accross workspaces
  Mod+Left                                                                                         { focus-column-left; }
  Mod+Down                                                                                         { focus-window-or-workspace-down; }
  Mod+Up                                                                                           { focus-window-or-workspace-up; }
  Mod+Right                                                                                        { focus-column-right; }
  Mod+H                                                                                            { focus-column-left; }
  Mod+J                                                                                            { focus-window-or-workspace-down; }
  Mod+K                                                                                            { focus-window-or-workspace-up; }
  Mod+L                                                                                            { focus-column-right; }
  Mod+Ctrl+Left                                                                                    { move-column-left; }
  Mod+Ctrl+Down                                                                                    { move-window-down; }
  Mod+Ctrl+Up                                                                                      { move-window-up; }
  Mod+Ctrl+Right                                                                                   { move-column-right; }
  Mod+Ctrl+H                                                                                       { move-column-left; }
  Mod+Ctrl+J                                                                                       { move-window-down-or-to-workspace-down; }
  Mod+Ctrl+K                                                                                       { move-window-up-or-to-workspace-up; }
  Mod+Ctrl+L                                                                                       { move-column-right; }
  Mod+Home                                                                                         { focus-column-first; }
  Mod+End                                                                                          { focus-column-last; }
  Mod+Ctrl+Home                                                                                    { move-column-to-first; }
  Mod+Ctrl+End                                                                                     { move-column-to-last; }

  // focus (Mod+Shift+Direction) and move (Mod+Shift+Ctrl+Direction) windows accross monitors
  Mod+Shift+Left                                                                                   { focus-monitor-left; }
  Mod+Shift+Down                                                                                   { focus-monitor-down; }
  Mod+Shift+Up                                                                                     { focus-monitor-up; }
  Mod+Shift+Right                                                                                  { focus-monitor-right; }
  Mod+Shift+H                                                                                      { focus-monitor-left; }
  Mod+Shift+J                                                                                      { focus-monitor-down; }
  Mod+Shift+K                                                                                      { focus-monitor-up; }
  Mod+Shift+L                                                                                      { focus-monitor-right; }
  Mod+Shift+Tab                                                                                    { focus-monitor-next; }
  Mod+Shift+Ctrl+Left                                                                              { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+Down                                                                              { move-column-to-monitor-down; }
  Mod+Shift+Ctrl+Up                                                                                { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+Right                                                                             { move-column-to-monitor-right; }
  Mod+Shift+Ctrl+H                                                                                 { move-column-to-monitor-left; }
  Mod+Shift+Ctrl+J                                                                                 { move-column-to-monitor-down; }
  Mod+Shift+Ctrl+K                                                                                 { move-column-to-monitor-up; }
  Mod+Shift+Ctrl+L                                                                                 { move-column-to-monitor-right; }

  // stacking windows in a column
  Mod+BracketLeft                                                                                  { consume-or-expel-window-left; }
  Mod+BracketRight                                                                                 { consume-or-expel-window-right; }
  Mod+Comma                                                                                        { consume-window-into-column; }
  Mod+Period                                                                                       { expel-window-from-column; }

  // managing window sizes
  Mod+R                                                                                            { switch-preset-column-width-back; }
  Mod+E                                                                                            { switch-preset-column-width; }
  Mod+Shift+R                                                                                      { switch-preset-window-height; }
  Mod+Shift+E                                                                                      { switch-preset-window-height-back; }
  Mod+Shift+F                                                                                      { reset-window-height; }
  Alt+Ctrl+F                                                                                       { maximize-window-to-edges; }
  Mod+F                                                                                            { maximize-column; }
  Mod+Ctrl+F                                                                                       { fullscreen-window; }
  Alt+F                                                                                            { expand-column-to-available-width; }
  Mod+Minus                                                                                        { set-column-width "-10%"; }
  Mod+Equal                                                                                        { set-column-width "+10%"; }
  Mod+Ctrl+Minus                                                                                   { set-column-width "-5%"; }
  Mod+Ctrl+Equal                                                                                   { set-column-width "+5%"; }
  Mod+Shift+Minus                                                                                  { set-window-height "-10%"; }
  Mod+Shift+Equal                                                                                  { set-window-height "+10%"; }
  Mod+Shift+Ctrl+Minus                                                                             { set-window-height "-5%"; }
  Mod+Shift+Ctrl+Equal                                                                             { set-window-height "+5%"; }

  // misc - centering windows, floating windows, and tabbed column display
  Mod+I                                                                                            { center-window; }
  Mod+T                                                                                            { switch-focus-between-floating-and-tiling; }
  Mod+Ctrl+T                                                                                       { toggle-window-floating; }
  Mod+W                                                                                            { toggle-column-tabbed-display; }

  // move workspaces within a monitor
  Mod+Ctrl+Page_Down                                                                               { move-workspace-down; }
  Mod+Ctrl+Page_Up                                                                                 { move-workspace-up; }
  Mod+Ctrl+U                                                                                       { move-workspace-down; }
  Mod+Ctrl+I                                                                                       { move-workspace-up; }

  // move workspaces across monitors
  Mod+Alt+H                                                                                        { move-workspace-to-monitor-left; }
  Mod+Alt+J                                                                                        { move-workspace-to-monitor-down; }
  Mod+Alt+K                                                                                        { move-workspace-to-monitor-up; }
  Mod+Alt+L                                                                                        { move-workspace-to-monitor-right; }

  // scroll wheel stuff - focus
  Mod+WheelScrollDown                                                               cooldown-ms=150                    { focus-column-right; }
  Mod+WheelScrollUp                                                                 cooldown-ms=150                    { focus-column-left; }
  Alt+WheelScrollDown                                                               cooldown-ms=150                    { focus-workspace-down; }
  Alt+WheelScrollUp                                                                 cooldown-ms=150                    { focus-workspace-up; }

  // Applications such as remote-desktop clients and software KVM switches may
  // request that niri stops processing the keyboard shortcuts defined here
  // so they may, for example, forward the key presses as-is to a remote machine.
  // It's a good idea to bind an escape hatch to toggle the inhibitor,
  // so a buggy application can't hold your session hostage.
  //
  // The allow-inhibiting=false property can be applied to other binds as well,
  // which ensures niri always processes them, even when an inhibitor is active.
  Mod+Delete                                                                        allow-inhibiting=false             { toggle-keyboard-shortcuts-inhibit; }
}

// mod+tab stuff
recent-windows {
  debounce-ms 750
  open-delay-ms 150

  highlight {
    active-color "#7aa2f7"
    urgent-color "#ff9999ff"
    padding 30
    corner-radius 12
  }

  previews {
    max-height 480
    max-scale 0.5
  }

  binds {
    Mod+Tab         { next-window; }
    Mod+Shift+Tab   { previous-window; }
    Mod+grave       { next-window     filter="app-id"; }
    Mod+Shift+grave { previous-window filter="app-id"; }
  }
}

hotkey-overlay {
  skip-at-startup
  hide-not-bound
}
